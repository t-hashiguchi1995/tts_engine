# Gateway
PORT=8080
PIPER_SERVICE_URL=http://piper:8080
IRODORI_SERVICE_URL=http://irodori:8080
API_KEYS=
INTERNAL_USE_IAM=false
REQUEST_TIMEOUT=600

# Piper service
PIPER_MODEL=ja_JP-tsukuyomi-chan-medium
PIPER_MODELS_DIR=/models/piper
PIPER_DOWNLOAD_ON_START=true
PIPER_USE_CUDA=false

# Irodori service
IRODORI_BASE_HF_REPO=Aratako/Irodori-TTS-500M-v2
IRODORI_VOICE_DESIGN_HF_REPO=Aratako/Irodori-TTS-500M-v2-VoiceDesign
IRODORI_CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
IRODORI_MODEL_DEVICE=cpu
IRODORI_CODEC_DEVICE=cpu
IRODORI_MODEL_PRECISION=fp32
HF_TOKEN=
